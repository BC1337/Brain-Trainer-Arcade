generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int         @id @default(autoincrement())
  email      String      @unique
  username   String      @unique
  password   String
  createdAt  DateTime    @default(now())
  highscores Highscore[] 
}

model Highscore {
  id        Int      @id @default(autoincrement())
  game      String   // e.g., "chimp", "aim", "verbal"
  rounds    Int      // This is our primary score metric
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  // This ensures a user only has ONE highscore per game
  @@unique([userId, game]) 
}